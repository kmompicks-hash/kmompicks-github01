# 케이맘픽스 워드프레스 자동 업로드 설정 (publish_wp.ps1)
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.
# .env 는 .gitignore 에 들어 있어 깃허브(공개 저장소)에 올라가지 않습니다.

# 사이트 주소 (끝에 / 없이, https 필수)
WP_URL=https://kmompicks.com
# 워드프레스 로그인 아이디 (이메일 아님, 사용자명)
WP_USERNAME=
# 애플리케이션 비밀번호: 관리자 > 사용자 > 프로필 > "애플리케이션 비밀번호"에서 발급
# (로그인 비밀번호가 아닙니다. 띄어쓰기 포함 그대로 붙여넣어도 됩니다)
WP_APP_PASSWORD=

# 기본 상태: draft(임시저장, 권장) / pending / private / publish
WP_DEFAULT_STATUS=draft
# 항상 넣을 카테고리 (쉼표로 여러 개, 비워 두면 data.json 의 category 만 사용)
WP_DEFAULT_CATEGORY=
# 없는 태그를 자동으로 만들지 여부
WP_CREATE_MISSING_TERMS=true
# 없는 카테고리를 자동으로 만들지 여부 (기본 false: 기존 카테고리만 사용)
WP_CREATE_MISSING_CATEGORIES=false
